{
    "name": "alex-kassel/site-cloner",
    "description": "Full website and demo-template offline cloner for Laravel with asset rewriting, resource inspection, and multi-language support.",
    "keywords": [
        "laravel",
        "site-cloner",
        "website-crawler",
        "offline-browser",
        "asset-rewriter",
        "web-archiver",
        "scraper"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "AlexKassel",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "symfony/dom-crawler": "^7.0|^8.0",
        "symfony/css-selector": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AlexKassel\\SiteCloner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexKassel\\SiteCloner\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlexKassel\\SiteCloner\\SiteClonerServiceProvider"
            ]
        }
    }
}
